{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container"
    },
    "agent-adk": {
      "root": "agent-adk",
      "framework": "fastapi"
    },
    "agent-ag2": {
      "root": "agent-ag2",
      "framework": "fastapi"
    },
    "agent-agno": {
      "root": "agent-agno",
      "framework": "fastapi"
    },
    "agent-bot": {
      "root": "agent-bot",
      "runtime": "container"
    },
    "agent-claude-sdk": {
      "root": "agent-claude-sdk",
      "framework": "fastapi"
    },
    "agent-computer": {
      "root": "agent-computer",
      "runtime": "container"
    },
    "agent-crewai": {
      "root": "agent-crewai",
      "runtime": "python"
    },
    "agent-langgraph": {
      "root": "agent-langgraph",
      "runtime": "container"
    },
    "agent-langgraph-agui": {
      "root": "agent-langgraph-agui",
      "framework": "fastapi"
    },
    "agent-langroid": {
      "root": "agent-langroid",
      "framework": "fastapi"
    },
    "agent-llamaindex": {
      "root": "agent-llamaindex",
      "framework": "fastapi"
    },
    "agent-mastra": {
      "root": "agent-mastra",
      "framework": "mastra"
    },
    "agent-microsoft": {
      "root": "agent-microsoft",
      "framework": "fastapi"
    },
    "agent-pydantic-ai": {
      "root": "agent-pydantic-ai",
      "framework": "fastapi"
    },
    "agent-strands": {
      "root": "agent-strands",
      "framework": "fastapi"
    },
    "app-2": {
      "root": "app",
      "framework": "vite"
    },
    "desktop": {
      "root": "desktop",
      "framework": "vite"
    },
    "src-tauri": {
      "root": "desktop/src-tauri",
      "runtime": "rust"
    },
    "server": {
      "root": "server",
      "framework": "hono"
    },
    "supervisor": {
      "root": "supervisor",
      "framework": "hono"
    }
  },
  "rewrites": [
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "app-2"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
```
